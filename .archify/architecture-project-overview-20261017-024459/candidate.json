  "cards": [
    { "dot": "emerald", "title": "單顆三站流程", "items": [
      "HC-SR04 確認抵達後 ESP32 本機停止送料，再建立採集工作階段",
      "每站：果實停穩 → 手機上傳 → Django 原子保存 → 放行下一閘門",
      "第 3 張保存後果實停在 Gate 3，等待分類"
    ] },
    { "dot": "cyan", "title": "檢測與分類", "items": [
      "蒐集模式：人工分類；自動檢測：YOLO 四模型 + XGBoost 判級",
      "無法判級時待人工選級，來源另記，不改寫模型輸出",
      "classify_fruit：分類器就位 500 ms → 放行 Gate 3 → 全部歸位"
    ] },
    { "dot": "rose", "title": "安全原則", "items": [
      "ESP32 只輪詢 Django，伺服器不主動呼叫硬體",
      "AI 只輸出結構化結果，不直接控制 GPIO 或角度",
      "HTTP timeout 視為不確定，retry 必須冪等，不重複實體送料"
    ] }
  ]
